# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGO_DB=turismo_loja

# YouTube Data API v3 — https://console.cloud.google.com/
# Habilita "YouTube Data API v3" y crea una API Key (Credentials → Create API Key)
YOUTUBE_API_KEY=

# SerpApi (Google Reviews) — https://serpapi.com/manage-api-key
# Cada lugar necesita su "google_data_id" configurado en la pantalla Lugares
# para que se le puedan traer reviews.
# Soporta varias keys separadas por coma (rota sola cuando una se agota):
# SERPAPI_KEY=key1,key2,key3
SERPAPI_KEY=
